# Copy to .env (git-ignored). Docker Compose and Nx both read it.
# Change every password. Use URL-safe characters only (letters, digits, - _),
# e.g. `openssl rand -hex 24`, because they are embedded in connection URLs.
# Each password appears twice: once for Compose, once in the URL below it
# that host-run tools (pnpm db:*, pnpm nx serve api) use.

# --- Postgres ---
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
APP_MIGRATOR_PASSWORD=change-me-migrator
APP_RUNTIME_PASSWORD=change-me-runtime
# POSTGRES_PORT=5432

# --- Host-run tools (Compose builds its own URLs from the passwords above) ---
MIGRATOR_DATABASE_URL=postgres://app_migrator:change-me-migrator@localhost:5432/deskquest
# The API must use the restricted runtime role, never app_migrator.
DATABASE_URL=postgres://app_runtime:change-me-runtime@localhost:5432/deskquest

# --- Web (Compose) ---
# WEB_PORT=8080
# WEB_BIND=127.0.0.1

# --- Outgoing email (magic links, invites) ---
# In dev, `docker compose up` routes the containerised API to Mailpit
# (UI: http://localhost:8025). These values apply to a host-run API and to
# servers started with `-f docker-compose.yml`.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=deskquest@your-company.example

# --- API (optional, defaults shown) ---
# NODE_ENV=development
# HOST=localhost
# PORT=3000
# LOG_LEVEL=info
